---
import SectionHead from '@/components/ui/SectionHead.astro';
import Photo from '@/components/ui/Photo.astro';
import { process } from '@/content/home';
---

<section class="frame py-28 md:py-40" aria-labelledby="processo-title">
  <SectionHead n="05" kicker="Come lavoriamo" title="Dalla misura alla posa, senza passaggi di mano" id="processo-title" />

  <ol class="process mt-14 grid gap-y-12 md:mt-24 md:grid-cols-4 md:gap-x-8">
    {
      process.map((step, i) => (
        <li class="process-step" data-reveal style={`--d:${i}`}>
          <span class="process-node" aria-hidden="true" />
          <span class="process-n tabular" aria-hidden="true">{step.n}</span>
          <h3 class="mt-4 text-4xl leading-none">{step.title}</h3>
          <p class="mt-4 max-w-xs leading-relaxed text-bone-muted">{step.text}</p>
        </li>
      ))
    }
  </ol>

  <div class="grid-12 mt-20 gap-y-6 md:mt-28">
    <div class="col-span-4 md:col-span-8">
      <Photo id="officinaBanco" ratio="16 / 9" sizes="(min-width: 768px) 66vw, 100vw" />
    </div>
    <div class="col-span-4 flex flex-col justify-end md:col-span-4">
      <p class="label">Fase 03 — Laboratorio</p>
      <p class="mt-3 text-bone-muted leading-relaxed">
        Taglio, saldatura e trattamenti si fanno in laboratorio, dove si lavora in piano e con gli attrezzi giusti.
        In cantiere arriva il pezzo finito, pronto da montare.
      </p>
      <a href="/contatti" class="btn btn-primary mt-8 self-start">
        Richiedi un sopralluogo <span class="btn-arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .process-step {
    position: relative;
    padding-top: 2.25rem;
    border-top: 1px solid var(--color-graphite-600);
  }
  .process-node {
    position: absolute;
    top: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    background: var(--color-brand);
  }
  .process-n {
    display: block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 5.5rem;
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1px var(--color-graphite-500);
  }
</style>
