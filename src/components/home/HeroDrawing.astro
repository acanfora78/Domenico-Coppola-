---
/**
 * Prospetto tecnico della hero, definito UNA volta come sprite e richiamato con <use>.
 * Ogni gruppo legge variabili CSS ereditate dal <use>:
 *   --df  disegno facciata (1 = nascosta, 0 = disegnata)   --fo  opacità facciata
 *   --d1…--d5  disegno dei 5 elementi in ferro              --o1…--o5  opacità
 * Tutti i tratti hanno pathLength="1" così il disegno va da 1 a 0 per qualsiasi lunghezza.
 */

// — Generatori di tracciati ripetitivi —
const range = (from: number, to: number, step: number) => {
  const out: number[] = [];
  for (let v = from; v <= to + 0.001; v += step) out.push(v);
  return out;
};
const circle = (cx: number, cy: number, r: number) =>
  `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${r * 2} 0a${r} ${r} 0 1 0 ${-r * 2} 0`;

// Tratteggio del terreno
const groundHatch = range(34, 1170, 28)
  .map((x) => `M${x} 700l-12 14`)
  .join('');

// 01 Cancello: bacchette verticali e anelli decorativi
const gateBars = range(144, 316, 12)
  .filter((x) => x < 220 || x > 236)
  .map((x) => `M${x} 590V676`)
  .join('');
const gateRings = [142, 158, 174, 190, 206, 250, 266, 282, 298, 314]
  .map((x) => circle(x, 580, 7))
  .join('');

// 02 Ringhiera: bacchette a passo costante
const railBalusters = range(575, 706, 9)
  .filter((x) => x < 635 || x > 645)
  .map((x) => `M${x} 400V432`)
  .join('');

// 04 Recinzione: motivo a cerchi intrecciati tagliato al plasma, un tracciato per pannello
const plasma = (x0: number, y0: number) => {
  const a = [];
  for (let i = 0; i <= 4; i++) for (let j = 0; j <= 3; j++) a.push(circle(x0 + 32 * i, y0 + 32 * j, 16));
  for (let i = 0; i <= 3; i++) for (let j = 0; j <= 2; j++) a.push(circle(x0 + 16 + 32 * i, y0 + 16 + 32 * j, 16));
  return a.join('');
};

// 05 Struttura: gradini della scala al soppalco
const stairTreads = range(1, 13, 1)
  .map((k) => {
    const x = 650 + 15.1 * k;
    const y = 700 - 19.5 * k;
    return `M${(x - 10).toFixed(1)} ${y.toFixed(1)}H${(x + 6).toFixed(1)}`;
  })
  .join('');
---

<svg class="dl-sprite" aria-hidden="true" focusable="false" width="0" height="0">
  <defs>
    <clipPath id="dl-clip-p1"><rect x="898" y="558" width="124" height="92"></rect></clipPath>
    <clipPath id="dl-clip-p2"><rect x="1034" y="558" width="124" height="92"></rect></clipPath>

    <g id="dl-drawing">
      <!-- ===== Facciata (sempre presente) ===== -->
      <g class="dl-facade">
        <path pathLength="1" d="M20 700H1180"></path>
        <path pathLength="1" class="thin" d={groundHatch}></path>
        <!-- corpo edificio + copertina -->
        <path pathLength="1" d="M400 700V180H880V700"></path>
        <path pathLength="1" d="M392 180H888V168H392Z"></path>
        <path pathLength="1" class="thin" d="M400 440H560M720 440H880"></path>
