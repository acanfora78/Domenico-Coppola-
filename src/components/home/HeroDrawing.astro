        <!-- soletta balcone -->
        <path pathLength="1" d="M560 440H720V452H560Z"></path>
        <!-- pilastri ingresso carrabile -->
        <path pathLength="1" d="M90 700V560H126V700M84 560V552H132V560M330 700V560H366V700M324 560V552H372V560"></path>
        <!-- muretti -->
        <path pathLength="1" d="M20 650H90M366 650H400"></path>
        <path pathLength="1" d="M880 654H1186V660H880M1180 660V700"></path>
        <!-- quote di livello -->
        <g class="dl-level">
          <path pathLength="1" d="M1196 440l-7-9h14ZM1196 180l-7-9h14ZM1196 700l-7-9h14Z"></path>
          <text x="1182" y="436" text-anchor="end">+3.00</text>
          <text x="1182" y="176" text-anchor="end">+6.40</text>
          <text x="1182" y="696" text-anchor="end">±0.00</text>
        </g>
      </g>

      <!-- ===== 01 Cancello ===== -->
      <g class="dl-el" style="--d: var(--d1, 0); --o: var(--o1, 1)">
        <g class="dl-iron">
          <path pathLength="1" d="M132 690V570H324V690Z"></path>
          <path pathLength="1" d="M226 570V690M230 570V690"></path>
          <path pathLength="1" d="M132 590H324M132 676H324"></path>
          <path pathLength="1" class="fine" d={gateBars}></path>
          <path pathLength="1" class="fine" d={gateRings}></path>
          <path pathLength="1" class="fine" d="M126 582h6M126 680h6M324 582h6M324 680h6M220 626h16v12h-16Z"></path>
        </g>
        <g class="dl-dim">
          <path pathLength="1" d="M126 530H330M126 521V539M330 521V539M121 535l10-10M325 535l10-10"></path>
          <text x="228" y="523" text-anchor="middle">3200</text>
        </g>
        <g class="dl-balloon"><circle cx="228" cy="494" r="12"></circle><text x="228" y="498" text-anchor="middle">01</text></g>
      </g>

      <!-- ===== 02 Ringhiera ===== -->
      <g class="dl-el" style="--d: var(--d2, 0); --o: var(--o2, 1)">
        <g class="dl-iron">
          <path pathLength="1" d="M562 396H718M562 400H718"></path>
          <path pathLength="1" d="M566 396V440M640 396V440M714 396V440"></path>
          <path pathLength="1" d="M566 432H714"></path>
          <path pathLength="1" class="fine" d={railBalusters}></path>
        </g>
        <g class="dl-dim">
          <path pathLength="1" d="M738 396V440M730 396H746M730 440H746M733 401l10-10M733 445l10-10"></path>
          <text x="758" y="422" text-anchor="middle" transform="rotate(-90 758 418)">1000</text>
        </g>
        <g class="dl-balloon"><circle cx="774" cy="372" r="12"></circle><text x="774" y="376" text-anchor="middle">02</text></g>
      </g>

      <!-- ===== 03 Pensilina ===== -->
      <g class="dl-el" style="--d: var(--d3, 0); --o: var(--o3, 1)">
        <g class="dl-iron">
          <path pathLength="1" d="M556 528H724V538H556Z"></path>
