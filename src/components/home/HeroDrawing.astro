          <path pathLength="1" d="M568 528L606 478M712 528L674 478"></path>
          <path pathLength="1" class="fine" d="M600 472h12v12h-12ZM668 472h12v12h-12Z"></path>
        </g>
        <g class="dl-dim">
          <path pathLength="1" d="M556 548H724M556 542V554M724 542V554M551 553l10-10M719 553l10-10"></path>
          <text x="736" y="552">2400</text>
        </g>
        <g class="dl-balloon"><circle cx="760" cy="500" r="12"></circle><text x="760" y="504" text-anchor="middle">03</text></g>
      </g>

      <!-- ===== 04 Recinzione taglio plasma ===== -->
      <g class="dl-el" style="--d: var(--d4, 0); --o: var(--o4, 1)">
        <g class="dl-iron">
          <path pathLength="1" d="M888 654V548H896V654M1024 654V548H1032V654M1160 654V548H1168V654"></path>
          <path pathLength="1" class="fine" d="M886 548l6-8 6 8M1022 548l6-8 6 8M1158 548l6-8 6 8"></path>
          <path pathLength="1" d="M896 556H1024V652H896ZM1032 556H1160V652H1032Z"></path>
          <g clip-path="url(#dl-clip-p1)"><path pathLength="1" class="fine cut" d={plasma(896, 556)}></path></g>
          <g clip-path="url(#dl-clip-p2)"><path pathLength="1" class="fine cut" d={plasma(1032, 556)}></path></g>
        </g>
        <g class="dl-dim">
          <path pathLength="1" d="M892 526H1028M892 517V535M1028 517V535M887 531l10-10M1023 531l10-10"></path>
          <text x="960" y="519" text-anchor="middle">2000</text>
        </g>
        <g class="dl-balloon"><circle cx="1104" cy="512" r="12"></circle><text x="1104" y="516" text-anchor="middle">04</text></g>
      </g>

      <!-- ===== 05 Struttura metallica e soppalco ===== -->
      <g class="dl-el" style="--d: var(--d5, 0); --o: var(--o5, 1)">
        <g class="dl-iron">
          <path pathLength="1" d="M416 700V186M426 700V186M634 700V186M644 700V186M852 700V186M862 700V186"></path>
          <path pathLength="1" d="M416 186H862M416 196H862M416 436H862M416 446H862"></path>
          <path pathLength="1" class="fine" d="M410 700v-6h22v6M628 700v-6h22v6M846 700v-6h22v6"></path>
          <path pathLength="1" class="fine" d="M412 432h18v18h-18ZM630 432h18v18h-18ZM848 432h18v18h-18Z"></path>
          <path pathLength="1" class="fine" d="M426 446L634 694M634 446L426 694"></path>
          <path pathLength="1" class="fine" d="M644 196L852 436M852 196L644 436"></path>
          <path pathLength="1" d="M650 700L846 446M662 700L852 454"></path>
          <path pathLength="1" class="fine" d={stairTreads}></path>
        </g>
        <g class="dl-dim">
          <path pathLength="1" d="M384 446V700M376 446H392M376 700H392M379 451l10-10M379 705l10-10"></path>
          <text x="372" y="573" text-anchor="middle" transform="rotate(-90 372 573)">2700</text>
          <text x="652" y="226">HEA 200</text>
          <text x="440" y="428">IPE 240</text>
        </g>
        <g class="dl-balloon"><circle cx="914" cy="318" r="12"></circle><text x="914" y="322" text-anchor="middle">05</text></g>
      </g>
    </g>
  </defs>
</svg>

<style is:global>
  .dl-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  /* — Stili del disegno (si applicano anche alle istanze <use>) — */
  #dl-drawing path,
  #dl-drawing circle {
    fill: none;
    stroke-linecap: butt;
    stroke-linejoin: miter;
  }
  #dl-drawing text {
    font-family: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.06em;
    stroke: none;
  }
  .dl-facade {
    opacity: var(--fo, 1);
  }
  .dl-facade path {
    stroke: #edebe6;
    stroke-opacity: 0.44;
    stroke-width: var(--sw-facade, 1.2);
    stroke-dasharray: 1 1;
    stroke-dashoffset: var(--df, 0);
  }
  .dl-facade path.thin {
    stroke-opacity: 0.26;
  }
  .dl-level text {
    fill: #8a8883;
    opacity: calc(1 - var(--df, 0));
  }
  .dl-level path {
    stroke-opacity: 0.5;
  }

  .dl-el {
    opacity: var(--o);
  }
  .dl-el path {
    stroke-dasharray: 1 1;
    stroke-dashoffset: var(--d);
  }
  .dl-iron path {
    stroke: #edebe6;
    stroke-width: var(--sw-iron, 2);
  }
  .dl-iron path.fine {
    stroke-width: var(--sw-fine, 1.3);
  }
  .dl-iron path.cut {
    stroke: #edebe6;
    stroke-opacity: 0.85;
  }
  .dl-dim path {
    stroke: #8a8883;
    stroke-width: 0.9;
  }
  .dl-dim text {
    fill: #9a9893;
    opacity: calc(1 - var(--d) * 2);
  }
  .dl-balloon {
    opacity: calc(1 - var(--d) * 3);
  }
  .dl-balloon circle {
    stroke: #e5584a;
    stroke-width: 1.2;
  }
  .dl-balloon text {
    fill: #e5584a;
    font-weight: 600;
  }
</style>
