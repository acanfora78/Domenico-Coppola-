---
import { site } from '@/content/site';
import { services } from '@/content/services';
import Logo from '@/components/ui/Logo.astro';
import Tbc from '@/components/ui/Tbc.astro';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-graphite-800 pt-16 pb-28 sm:pb-12">
  <div class="frame">
    <div class="grid-12 gap-y-12">
      <div class="col-span-4 md:col-span-4">
        <Logo />
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-bone-muted">
          Carpenteria metallica artigianale. Progetto, laboratorio e posa a Scafati e in provincia di Salerno.
        </p>
      </div>

      <div class="col-span-2 md:col-span-3">
        <p class="label mb-5">Servizi</p>
        <ul class="space-y-2.5 text-sm">
          {services.map((s) => <li><a href={s.href} class="link-draw text-bone/85 hover:text-bone">{s.name}</a></li>)}
        </ul>
      </div>

      <div class="col-span-2 md:col-span-2">
        <p class="label mb-5">Studio</p>
        <ul class="space-y-2.5 text-sm">
          <li><a href="/lavori" class="link-draw text-bone/85 hover:text-bone">Lavori</a></li>
          <li><a href="/chi-siamo" class="link-draw text-bone/85 hover:text-bone">Chi siamo</a></li>
          <li><a href="/contatti" class="link-draw text-bone/85 hover:text-bone">Contatti</a></li>
        </ul>
      </div>

      <address class="col-span-4 md:col-span-3 not-italic text-sm leading-relaxed">
        <p class="label mb-5">Laboratorio</p>
        <p>{site.address.street}<br />{site.address.postalCode} {site.address.city} ({site.address.province})</p>
        <p class="mt-3"><a href={site.phone.href} class="link-draw tabular">{site.phone.display}</a></p>
        <p class="mt-1 text-bone-muted"><Tbc text="email @carpenteriadilallo.com" kind="DA DEFINIRE" /></p>
      </address>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-graphite-800 pt-6 text-xs text-bone-faint sm:flex-row sm:justify-between">
      <p>© {year} {site.name} · P.IVA {site.vat}</p>
      <p class="flex gap-5">
        <a href="/privacy" class="link-draw">Privacy</a>
        <a href="/cookie" class="link-draw">Cookie</a>
      </p>
    </div>
  </div>
</footer>
