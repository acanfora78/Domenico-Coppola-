---
import { site } from '@/content/site';
---

<a
  href={site.whatsapp}
  class="wa-fab"
  target="_blank"
  rel="noopener"
  aria-label="Scrivici su WhatsApp (si apre in una nuova scheda)"
>
  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2Zm0 18.15c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.55-3.7 8.24-8.24 8.24Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.54.06-.25-.13-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.39 1.01 2.56.12.16 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.28Z"
    ></path>
  </svg>
  <span class="wa-label">WhatsApp</span>
</a>

<style>
  .wa-fab {
    position: fixed;
    right: clamp(1rem, 2.5vw, 2rem);
    bottom: clamp(1rem, 2.5vw, 2rem);
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    height: 3.25rem;
    padding: 0 1.125rem 0 0.9375rem;
    background: var(--color-graphite-800);
    color: var(--color-bone);
    border: 1px solid var(--color-graphite-600);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.6);
    transition:
      background-color 0.3s,
      border-color 0.3s;
  }
  .wa-fab:hover {
    background: #128c4a;
    border-color: #128c4a;
  }
  @media (max-width: 639px) {
    .wa-fab {
      width: 3.25rem;
      padding: 0;
      justify-content: center;
    }
    .wa-label {
      display: none;
    }
  }
</style>
