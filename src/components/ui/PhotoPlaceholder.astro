---
/** Riquadro scuro con etichetta tecnica: segnaposto per foto dello shooting */
interface Props {
  label: string;
  ratio?: string;
  class?: string;
}
const { label, ratio = '4 / 3', class: cls = '' } = Astro.props;
---

<div class:list={['ph brushed', cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={`Foto in arrivo: ${label}`}>
  <svg class="ph-x" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 0L100 100M100 0L0 100" vector-effect="non-scaling-stroke"></path>
  </svg>
  <span class="ph-corner ph-tl" aria-hidden="true"></span>
  <span class="ph-corner ph-br" aria-hidden="true"></span>
  <span class="ph-label label" aria-hidden="true">{label}</span>
</div>

<style>
  .ph {
    position: relative;
    margin: 0;
    background-color: var(--color-graphite-900);
    border: 1px solid var(--color-graphite-700);
    overflow: hidden;
    container-type: inline-size;
  }
  @container (max-width: 260px) {
    .ph-label {
      left: 0.5rem;
      right: 0.5rem;
      bottom: 0.5rem;
      font-size: 0.5625rem;
    }
  }
  .ph-x {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ph-x path {
    stroke: var(--color-graphite-700);
    stroke-width: 1;
    fill: none;
  }
  .ph-corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--color-brand);
  }
  .ph-tl {
    top: 10px;
    left: 10px;
    border-top: 1px solid;
    border-left: 1px solid;
  }
  .ph-br {
    right: 10px;
    bottom: 10px;
    border-right: 1px solid;
    border-bottom: 1px solid;
  }
  .ph-label {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    right: 2.5rem;
    padding: 0.375rem 0.5rem;
    background: var(--color-steel);
    color: var(--color-bone-muted);
  }
</style>
