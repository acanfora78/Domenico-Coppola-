---
/** Marchio provvisorio: sezione di trave HEA + logotipo. Da sostituire con il logo ufficiale. */
interface Props {
  mono?: boolean;
}
const { mono = false } = Astro.props;
---

<span class="logo" data-mono={mono || undefined}>
  <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" class="logo-mark">
    <rect width="32" height="32" class="logo-bg"></rect>
    <path d="M8 8h16v3.5h-6.25v9h6.25V24H8v-3.5h6.25v-9H8Z" class="logo-beam"></path>
  </svg>
  <span class="logo-type">
    <span class="logo-name">Di Lallo</span>{" "}
    <span class="logo-sub">Carpenteria</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .logo-bg {
    fill: var(--color-brand);
  }
  .logo-beam {
    fill: var(--color-bone);
  }
  [data-mono] .logo-bg {
    fill: var(--color-bone);
  }
  [data-mono] .logo-beam {
    fill: var(--color-brand);
  }
  .logo-type {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .logo-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.375rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .logo-sub {
    margin-top: 0.125rem;
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    opacity: 0.8;
  }
</style>
